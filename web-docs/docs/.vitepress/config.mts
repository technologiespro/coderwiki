// Конфигурация VitePress строится из generated-manifest.json — ничего не захардкожено
import { defineConfig, type DefaultTheme, type HeadConfig } from 'vitepress';
import { withMermaid } from 'vitepress-plugin-mermaid';
import fs from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';
import { langByCode } from '../../scripts/lib/langs.mjs';
import { altPath } from '../../scripts/lib/nav.mjs';
import { strings } from './i18n';

const here = path.dirname(fileURLToPath(import.meta.url));
const manifestPath = path.join(here, 'generated-manifest.json');
const manifest = fs.existsSync(manifestPath)
  ? JSON.parse(fs.readFileSync(manifestPath, 'utf8'))
  : { generatedAt: new Date().toISOString(), siteUrl: 'http://localhost:4173', basePath: '/', languages: [], repos: [] };

const SITE_URL: string = manifest.siteUrl;
const BASE: string = manifest.basePath;
// Русский и английский включены всегда, остальные — только если есть в data/
const LANG_CODES: string[] = [...new Set<string>(['en', 'ru', ...manifest.languages])];
const GROUP_THRESHOLD = 12;
const GROUP_SIZE = 6;

type Chapter = { num: number | null; slug: string; title: string; path: string };
type RepoLang = { code: string; path: string; title: string; description: string; chapters: Chapter[] };
type Repo = { key: string; owner: string; repo: string; langs: Record<string, RepoLang> };
const repos: Repo[] = manifest.repos;

function sidebarFor(code: string): DefaultTheme.SidebarMulti {
  const s = strings(code);
  const out: DefaultTheme.SidebarMulti = {};
  for (const r of repos) {
    const v = r.langs[code];
    if (!v) continue;
    const overview = { text: s.overview, link: v.path };
    const items = v.chapters.map((c) => ({ text: c.title, link: c.path }));
    let groups: DefaultTheme.SidebarItem[];
    if (items.length > GROUP_THRESHOLD) {
      // Двухуровневое дерево: главы разбиваются на свёртываемые блоки
      groups = [];
      for (let i = 0; i < items.length; i += GROUP_SIZE) {
        const chunk = items.slice(i, i + GROUP_SIZE);
        groups.push({ text: `${s.chaptersRange} ${i + 1}–${i + chunk.length}`, collapsed: i > 0, items: chunk });
      }
    } else {
      groups = items;
    }
    out[v.path] = [{ text: r.repo, items: [overview, ...groups] }];
  }
  return out;
}

function themeFor(code: string, homeLink = '/'): DefaultTheme.Config {
  const s = strings(code);
  return {
    nav: [{ text: s.repositories, link: homeLink }],
    sidebar: sidebarFor(code),
    outline: { level: [2, 3], label: s.onThisPage },
    sidebarMenuLabel: s.menu,
    darkModeSwitchLabel: s.appearance,
    returnToTopLabel: s.returnToTop,
    langMenuLabel: s.uiLanguage,
    docFooter: { prev: s.prev, next: s.next },
    footer: { message: s.generatedBy, copyright: `${s.lastBuild}: ${manifest.generatedAt.slice(0, 10)}` },
  };
}

function searchTranslations(code: string) {
  const s = strings(code);
  return {
    translations: {
      button: { buttonText: s.search, buttonAriaLabel: s.search },
      modal: {
        noResultsText: s.noResults,
        resetButtonTitle: s.reset,
        footer: { selectText: s.select, navigateText: s.navigate, closeText: s.close },
      },
    },
  };
}

const locales: Record<string, any> = {
  root: { label: 'English', lang: 'en', dir: 'ltr', themeConfig: themeFor('en') },
};
const searchLocales: Record<string, any> = { root: searchTranslations('en') };
for (const code of LANG_CODES) {
  const l = langByCode(code);
  locales[code] = {
    label: l.label,
    lang: l.htmlLang,
    dir: l.dir,
    link: `/${code}/`,
    description: strings(code).siteTagline,
    themeConfig: themeFor(code, `/${code}/`),
  };
  searchLocales[code] = searchTranslations(code);
}

function absUrl(p: string) {
  return SITE_URL + BASE + p.replace(/^\//, '');
}

export default withMermaid(
  defineConfig({
    title: 'CoderWiki Docs',
    description: 'Documentation generated by CoderWiki',
    base: BASE,
    cleanUrls: true,
    lastUpdated: false,
    appearance: true,
    sitemap: { hostname: SITE_URL + BASE },
    head: [
      ['link', { rel: 'icon', type: 'image/svg+xml', href: `${BASE}favicon.svg` }],
      ['meta', { name: 'theme-color', content: '#2563eb' }],
      ['meta', { property: 'og:site_name', content: 'CoderWiki Docs' }],
    ],
    locales,
    themeConfig: {
      logo: '/favicon.svg',
      search: { provider: 'local', options: { locales: searchLocales } },
      socialLinks: [],
      externalLinkIcon: true,
    },
    markdown: { lineNumbers: false },
    mermaid: { securityLevel: 'loose' },
    mermaidPlugin: { class: 'mermaid' },
    // SEO: canonical, OpenGraph, hreflang на версии главы на других языках
    transformPageData(pageData) {
      const fm = pageData.frontmatter;
      const head: HeadConfig[] = [];
      const pagePath: string = fm.cwPath || (pageData.relativePath === 'index.md' ? '/' : '');
      const url = absUrl(pagePath);
      head.push(['link', { rel: 'canonical', href: url }]);
      head.push(['meta', { property: 'og:url', content: url }]);
      head.push(['meta', { property: 'og:type', content: fm.cwRepo ? 'article' : 'website' }]);
      head.push(['meta', { property: 'og:title', content: fm.title || pageData.title || 'CoderWiki Docs' }]);
      if (fm.description) head.push(['meta', { property: 'og:description', content: fm.description }]);
      if (fm.keywords) head.push(['meta', { name: 'keywords', content: fm.keywords }]);
      const lang = langByCode(fm.cwLang || 'en');
      head.push(['meta', { property: 'og:locale', content: lang.ogLocale }]);
      if (fm.cwRepo) {
        const repo = repos.find((r) => r.key === fm.cwRepo);
        if (repo) {
          const codes = Object.keys(repo.langs);
          for (const code of codes) {
            const alt = altPath(repo, code, fm.cwPath);
            if (alt) head.push(['link', { rel: 'alternate', hreflang: langByCode(code).htmlLang, href: absUrl(alt) }]);
          }
          const def = altPath(repo, codes.includes('en') ? 'en' : codes[0], fm.cwPath);
          if (def) head.push(['link', { rel: 'alternate', hreflang: 'x-default', href: absUrl(def) }]);
        }
      } else if (pageData.relativePath === 'index.md') {
        head.push(['link', { rel: 'alternate', hreflang: 'x-default', href: absUrl('/') }]);
      }
      return { frontmatter: { ...fm, head: [...(fm.head || []), ...head] } };
    },
    vite: {
      optimizeDeps: { include: ['mermaid'] },
    },
  })
);
