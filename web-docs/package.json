{
  "name": "coderwiki-web-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Статический портал документации, сгенерированной CoderWiki (VitePress)",
  "scripts": {
    "sync": "node scripts/sync.mjs",
    "dev": "node scripts/sync.mjs && vitepress dev docs --host 0.0.0.0 --port 4173",
    "build": "node scripts/sync.mjs && vitepress build docs",
    "preview": "vitepress preview docs --host 0.0.0.0 --port 4173"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "dotenv": "^16",
    "mermaid": "^11",
    "transliteration": "^2.3.5",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vue": "^3"
  }
}
